{
  "name": "link-game",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@12.9.1",
  "engines": {
    "node": ">=24.21.0 <25",
    "pnpm": ">=12.9.1 <13"
  },
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "preview": "vite preview --host 127.0.0.1",
    "typecheck": "tsc -p tsconfig.browser.json && tsc -p tsconfig.wechat.json && tsc -p tsconfig.tools.json",
    "test": "vitest run",
    "test:watch": "vitest",
    "build:browser": "vite build",
    "build:wechat": "node scripts/build-wechat.mjs",
    "build": "pnpm run build:browser && pnpm run build:wechat",
    "check": "pnpm run typecheck && pnpm run test && pnpm run build"
  },
  "devDependencies": {
    "@types/node": "24.19.2",
    "esbuild": "0.28.2",
    "minigame-api-typings": "3.8.22",
    "typescript": "7.0.2",
    "vite": "8.3.8",
    "vitest": "5.1.0"
  }
}
